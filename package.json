{
  "name": "distil",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && node scripts/check-formatting.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns='\\.unit\\.test\\.'",
    "test:component": "jest --runInBand --testPathPatterns='\\.component\\.test\\.'",
    "test:contract": "jest --runInBand --testPathPatterns='\\.contract\\.test\\.'",
    "test:integration": "node scripts/run-postgres-integration.mjs",
    "test:sqlite-compat": "jest --runInBand --testPathPatterns='\\.sqlite-integration\\.test\\.'",
    "test:security": "jest --runInBand --testPathPatterns='security'",
    "test:e2e": "playwright test tests/e2e --project=desktop-chromium --project=mobile-chromium --project=mobile-webkit",
    "test:extension": "playwright test tests/extension --project=extension",
    "test:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e && npm run test:extension && npm run build",
    "test:watch": "jest --watch",
    "test:coverage-gate": "node --test scripts/__tests__/coverage-gate.test.mjs",
    "test:coverage": "npm run test:coverage-gate && jest --config jest.coverage.config.ts --coverage --runInBand && node scripts/check-changed-coverage.mjs",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:live": "RUN_LIVE_CONNECTION_TESTS=1 jest --config jest.live.config.ts --runInBand",
    "eval": "tsx evals/run-evals.ts",
    "eval:live": "tsx evals/run-evals.ts --live",
    "eval:nightly": "tsx evals/nightly-eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import:sqlite": "tsx scripts/import-sqlite.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "^0.6.0",
    "@slack/web-api": "^7.14.1",
    "@vercel/queue": "^0.5.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^171.4.0",
    "jose": "^6.2.10",
    "jsdom": "22.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "openai": "^6.27.0",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20",
    "@types/pino": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.11.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "msw": "^2.10.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
