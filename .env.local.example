# Distil — local development against the Docker PostgreSQL in docker-compose.yml.
# Copy to .env.local (gitignored). See docs/runbooks/local-development.md.

# ── Database (docker compose up -d) ──────────────────────────────────────────
# Runtime: restricted login role created by `npm run db:local:reset`.
DATABASE_URL=postgresql://distil_app:distil_app@localhost:5433/distil_local
# Owner role for migrations and resets.
DATABASE_MIGRATION_URL=postgresql://distil:distil@localhost:5433/distil_local

# ── Capture pipeline ─────────────────────────────────────────────────────────
# Run the capture worker and the deep research stages in-process instead of
# Vercel Queue. Local only.
DISTIL_CAPTURE_DISPATCH=inline

# ── Auth (legacy password login; hosted Neon Auth stays off locally) ─────────
# Generate all three with: npm run local:secrets -- <your-local-password>
# (the hash is printed with `\$` escapes; paste it exactly as printed)
DISTIL_LEGACY_USER_ID=
DISTIL_SESSION_SECRET=
DISTIL_WEB_PASSWORD_HASH=
FEATURE_NEON_AUTH=false

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
DISTIL_ALLOWED_ORIGINS=http://localhost:3000
FEATURE_CONNECTORS=false
# Phase 2 experience flags default to off; turn them on to see the full app.
FEATURE_KNOWLEDGE_UI=true
FEATURE_SEARCH=true
FEATURE_ANSWERS=true
FEATURE_PERSONALIZATION=true
FEATURE_DIGESTS=true
SYNC_INTERVAL_HOURS=0
NEXT_PUBLIC_SYNC_INTERVAL_HOURS=0
LOG_LEVEL=info

# ── YouTube (optional) ───────────────────────────────────────────────────────
# Data API v3 key for video metadata when YouTube refuses the unofficial
# endpoints from the server's IP (Vercel). Google Cloud → APIs → YouTube Data API v3.
YOUTUBE_API_KEY=

# ── AI provider (at least one) ───────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
